# ============================================================
# Painel de Voos Monitorados — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real no repositório.
# ============================================================

# -----------------------------------------------------------------
# Autenticação (OBRIGATÓRIO em produção)
# -----------------------------------------------------------------

# Segredo criptográfico das sessões — gere com: openssl rand -hex 32
# FATAL: o servidor recusa iniciar em produção sem este valor.
SESSION_SECRET=troque-por-valor-gerado-com-openssl-rand-hex-32

# Conta administrador inicial — usada APENAS quando a tabela users está vazia.
# Após o primeiro boot, estas variáveis podem ser removidas (não têm efeito).
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=senha-forte-com-8-chars-minimo

# -----------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------

PORT=3000
NODE_ENV=development

# URL do frontend (para o header CORS em produção)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------

# Diretório onde os arquivos .sqlite serão salvos.
# Em produção (Docker), use o volume mapeado: DB_PATH=/data
# DB_PATH=/data

# -----------------------------------------------------------------
# API de status de voos (AeroDataBox via RapidAPI)
# -----------------------------------------------------------------

# stub  → dados fakes (desenvolvimento)
# real  → chama a API AeroDataBox (produção)
AVIATION_API_MODE=stub

# Obrigatória quando AVIATION_API_MODE=real
# RAPIDAPI_KEY=sua-chave-aqui

# Minutos mínimos de atraso para gerar alerta (padrão: 15)
# DELAY_THRESHOLD_MIN=15

# Voos processados por ciclo do scheduler de status (padrão: 10)
# STATUS_MONITOR_BATCH_SIZE=10

# -----------------------------------------------------------------
# Promoções (nova aba)
# -----------------------------------------------------------------

# stub → dados fakes (dev/test, sem chave); real → chama o Gemini Vision
EXTRACTION_MODE=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Fallback de imagem de fundo (biblioteca local tem prioridade)
PEXELS_API_KEY=

# Opcional; default backend/output/promos
PROMO_OUTPUT_DIR=

# -----------------------------------------------------------------
# Vouchers (nova aba — reemissão de vouchers Azul)
# -----------------------------------------------------------------

# Google Gemini API key (mesma var usada por Promoções).
# Sem ela, o voucherExtractor retorna dados STUB hardcoded (modo dev/test).
# GEMINI_API_KEY=

# URL pública onde o servidor é alcançável (usada pelo Playwright para
# navegar em /voucher-preview/:id ao exportar PDF/PNG).
# Default: http://localhost:${PORT}
# PUBLIC_BASE_URL=https://painel.suaempresa.com

# Dias até apagar automaticamente os PDFs/PNGs de origem (LGPD).
# Default: 30
# VOUCHER_RETENTION_DAYS=30

# Segredo HMAC para tokens de página pública de itinerário (90 dias TTL).
# Fallback: SESSION_SECRET. Gere com: openssl rand -hex 32
VOUCHER_TOKEN_SECRET=

# -----------------------------------------------------------------
# Notificações por E-MAIL (alertas de preço)
# -----------------------------------------------------------------
# Sem estas variáveis, nenhum e-mail é enviado quando um preço cai abaixo do alvo.
#
# Gmail: requer App Password (https://myaccount.google.com/apppasswords)
#        — a senha normal NÃO funciona se 2FA estiver ativado (recomendado).
#        Crie um App Password de 16 caracteres e cole em EMAIL_PASS sem espaços.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=app-password-de-16-chars
# Opcional — endereço exibido como remetente; default = EMAIL_USER
# EMAIL_FROM=Clube do Voo <contato@clubedovooviagens.com.br>

# -----------------------------------------------------------------
# Notificações por TELEGRAM (alertas de preço)
# -----------------------------------------------------------------
# Crie um bot via @BotFather no Telegram, copie o token aqui.
# Depois, no app, configure o telegram_chat_id de cada voo:
#   - chat pessoal: o usuario inicia conversa com o bot, depois acesse
#     https://api.telegram.org/bot<TOKEN>/getUpdates e copie chat.id
#   - grupo: adicione o bot ao grupo, envie uma mensagem, mesma URL acima
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------
# Scheduler de monitoramento de precos
# -----------------------------------------------------------------
# Os ciclos rodam em horarios FIXOS: 08:00 e 20:00 (America/Sao_Paulo).
# Isso esta hardcoded em backend/services/scheduler.js.
#
# Quantos scrapers rodam em paralelo por ciclo. Default: 3
# MAX_CONCURRENT_SCRAPERS=3
# Quando o preco atual subir acima de (alvo x THRESHOLD), o alerta e resetado
# e podera disparar novamente na proxima queda. Default: 1.10 (10% acima)
# ALERT_RESET_THRESHOLD=1.10
