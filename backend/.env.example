# ============================================================
# Painel de Voos Monitorados — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env real no repositório.
# ============================================================

# -----------------------------------------------------------------
# Autenticação (OBRIGATÓRIO em produção)
# -----------------------------------------------------------------

# Segredo criptográfico das sessões — gere com: openssl rand -hex 32
# FATAL: o servidor recusa iniciar em produção sem este valor.
SESSION_SECRET=troque-por-valor-gerado-com-openssl-rand-hex-32

# Conta administrador inicial — usada APENAS quando a tabela users está vazia.
# Após o primeiro boot, estas variáveis podem ser removidas (não têm efeito).
ADMIN_EMAIL=admin@suaempresa.com
ADMIN_PASSWORD=senha-forte-com-8-chars-minimo

# -----------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------

PORT=3000
NODE_ENV=development

# URL do frontend (para o header CORS em produção)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------

# Diretório onde os arquivos .sqlite serão salvos.
# Em produção (Docker), use o volume mapeado: DB_PATH=/data
# DB_PATH=/data

# -----------------------------------------------------------------
# API de status de voos (AeroDataBox via RapidAPI)
# -----------------------------------------------------------------

# stub  → dados fakes (desenvolvimento)
# real  → chama a API AeroDataBox (produção)
AVIATION_API_MODE=stub

# Obrigatória quando AVIATION_API_MODE=real
# RAPIDAPI_KEY=sua-chave-aqui

# Minutos mínimos de atraso para gerar alerta (padrão: 15)
# DELAY_THRESHOLD_MIN=15

# Voos processados por ciclo do scheduler de status (padrão: 10)
# STATUS_MONITOR_BATCH_SIZE=10

# -----------------------------------------------------------------
# Promoções (nova aba)
# -----------------------------------------------------------------

# stub → dados fakes (dev/test, sem chave); real → chama o Gemini Vision
EXTRACTION_MODE=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Fallback de imagem de fundo (biblioteca local tem prioridade)
PEXELS_API_KEY=

# Opcional; default backend/output/promos
PROMO_OUTPUT_DIR=
